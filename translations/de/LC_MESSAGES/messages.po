msgid "Невалиден формат! Системата приема само .dxf файлове."
msgstr "Ungültiges Format. Das System akzeptiert nur .dxf-Dateien."

#: app.py:4125
#, python-format
msgid "Файлът \"%(filename)s\" беше качен и обработен успешно!"
msgstr "Die Datei \"%(filename)s\" wurde erfolgreich hochgeladen und verarbeitet."

#: app.py:4130
#, python-format
msgid "Критична грешка при обработка/запис: %(error)s"
msgstr "Kritischer Fehler bei Verarbeitung/Speicherung: %(error)s"

#: app.py:6388
msgid "Моля изберете файл."
msgstr "Bitte wählen Sie eine Datei aus."

#: app.py:6410
msgid "Файлът беше качен успешно."
msgstr "Die Datei wurde erfolgreich hochgeladen."

#: app.py:7088
msgid "Няма избран файл."
msgstr "Keine Datei ausgewählt."

#: app.py:7091
msgid "Приемат се само PDF файлове."
msgstr "Es werden nur PDF-Dateien akzeptiert."

#: app.py:7108
msgid "Моля въведете име на клиент."
msgstr "Bitte geben Sie einen Kundennamen ein."

#: app.py:7119 templates/order_create.html:675
msgid "Моля добавете поне един артикул към поръчката."
msgstr "Bitte fügen Sie der Bestellung mindestens einen Artikel hinzu."

#: app.py:7198
msgid "Невалидни артикули в поръчката."
msgstr "Ungültige Artikel in der Bestellung."

#: app.py:7209
#, python-format
msgid "Поръчка %(order_number)s беше успешно изпратена!"
msgstr "Bestellung %(order_number)s wurde erfolgreich übermittelt."

#: app.py:7217
#, python-format
msgid ""
"Внимание: поръчка %(order_number)s има недостатъчна наличност за: "
"%(missing_desc)s. Виж таблото \"Липсваща наличност\"."
msgstr ""
"Achtung: Bestellung %(order_number)s hat unzureichenden Bestand für: "
"%(missing_desc)s. Siehe das Dashboard \"Fehlender Bestand\"."

#: app.py:7268
msgid "Нямате достъп до тази поръчка."
msgstr "Sie haben keinen Zugriff auf diese Bestellung."

#: app.py:7272
msgid ""
"Поръчката вече е в процес на изработка (или вече е приключена/отменена) и не"
" може да бъде отменена."
msgstr ""
"Die Bestellung befindet sich bereits in Bearbeitung (oder ist bereits "
"abgeschlossen/storniert) und kann nicht storniert werden."

#: app.py:7279
#, python-format
msgid "Поръчка %(order_number)s беше отменена."
msgstr "Bestellung %(order_number)s wurde storniert."

#: app.py:9576
msgid "Моля въведете име на клиента."
msgstr "Bitte geben Sie den Namen des Kunden ein."

#: app.py:9605
msgid "Моля въведете име на куриера."
msgstr "Bitte geben Sie den Namen des Kurierdienstes ein."

#: app.py:12366
msgid "Страницата не е намерена"
msgstr "Seite nicht gefunden"

#: app.py:12367
msgid "Проверете адреса или се върнете към началото."
msgstr "Überprüfen Sie die Adresse oder kehren Sie zur Startseite zurück."

#: app.py:12372
msgid "Нямате достъп"
msgstr "Zugriff verweigert"

#: app.py:12373
msgid "Нямате права за тази страница."
msgstr "Sie haben keine Berechtigung für diese Seite."

#: app.py:12378
msgid "Твърде много опити"
msgstr "Zu viele Versuche"

#: app.py:12379
msgid "Изчакайте малко и опитайте отново."
msgstr "Bitte warten Sie einen Moment und versuchen Sie es erneut."

#: app.py:12384
msgid "Възникна грешка"
msgstr "Ein Fehler ist aufgetreten"

#: app.py:12385
msgid "Нещо се обърка от наша страна. Опитайте отново по-късно."
msgstr ""
"Auf unserer Seite ist etwas schiefgelaufen. Bitte versuchen Sie es später "
"erneut."

#: app.py:12392
msgid "Изтекла сесия на формата"
msgstr "Formularsitzung abgelaufen"

#: app.py:12393
msgid "Презаредете страницата и опитайте отново."
msgstr "Laden Sie die Seite neu und versuchen Sie es erneut."

