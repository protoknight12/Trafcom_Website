#: app.py:650
msgid "ЕИК трябва да съдържа точно 9 цифри."
msgstr "Die EIK/USt-IdNr. muss genau 9 Ziffern enthalten."

#: app.py:665
msgid "Невалиден имейл адрес."
msgstr "Ungültige E-Mail-Adresse."

#: app.py:4870
msgid "Нямате достъп до това приложение."
msgstr "Sie haben keinen Zugriff auf diese Anwendung."

#: app.py:5551 app.py:9153
msgid "Моля въведете име на пресет."
msgstr "Bitte geben Sie einen Namen für die Voreinstellung ein."

#: app.py:5555 app.py:9157
msgid "Невалидни настройки."
msgstr "Ungültige Einstellungen."

#: app.py:5572 app.py:9173
msgid "Нямате достъп."
msgstr "Sie haben keinen Zugriff."

#: app.py:9341 app.py:9371 app.py:9386
msgid "Твърде много грешни кодове. Опитайте отново след 15 минути."
msgstr "Zu viele falsche Codes. Bitte versuchen Sie es in 15 Minuten erneut."

#: app.py:9353
msgid "Невалидно потребителско име или парола."
msgstr "Ungültiger Benutzername oder Passwort."

#: app.py:9367
msgid "Времето за въвеждане на кода изтече. Влезте отново."
msgstr ""
"Die Zeit zur Eingabe des Codes ist abgelaufen. Bitte melden Sie sich "
"erneut an."

#: app.py:9388
msgid "Невалиден код."
msgstr "Ungültiger Code."

#: app.py:9414
msgid ""
"Ако имейлът съществува в системата, изпратихме връзка за възстановяване "
"на паролата."
msgstr ""
"Falls diese E-Mail-Adresse in unserem System registriert ist, haben wir "
"einen Link zum Zurücksetzen des Passworts gesendet."

#: app.py:9427
msgid "Връзката за възстановяване е изтекла. Заявете нова."
msgstr ""
"Der Link zum Zurücksetzen ist abgelaufen. Bitte fordern Sie einen neuen "
"an."

#: app.py:9430 app.py:9437
msgid "Невалидна връзка за възстановяване."
msgstr "Ungültiger Link zum Zurücksetzen des Passworts."

#: app.py:9445 app.py:9485 app.py:9577
msgid "Паролата трябва да бъде поне 8 символа."
msgstr "Das Passwort muss mindestens 8 Zeichen lang sein."

#: app.py:9448 app.py:9580 templates/reset_password.html:42
msgid "Паролите не съвпадат."
msgstr "Die Passwörter stimmen nicht überein."

#: app.py:9452
msgid "Паролата е сменена успешно. Влезте с новата парола."
msgstr ""
"Passwort erfolgreich geändert. Bitte melden Sie sich mit dem neuen "
"Passwort an."

#: app.py:9465
msgid ""
"Сайтът е в момента на техническа поддръжка. Регистрацията на нови профили"
" е временно спряна."
msgstr ""
"Die Website befindet sich derzeit in Wartung. Die Registrierung neuer "
"Konten ist vorübergehend deaktiviert."

#: app.py:9478 app.py:9552
msgid "Имейл е задължителен."
msgstr "E-Mail-Adresse ist erforderlich."

#: app.py:9504
msgid "Това потребителско име или имейл вече съществува."
msgstr "Dieser Benutzername oder diese E-Mail-Adresse wird bereits verwendet."

#: app.py:9508
msgid "Регистрацията е успешна! Проверете имейла си, за да потвърдите адреса."
msgstr ""
"Registrierung erfolgreich. Bitte prüfen Sie Ihre E-Mails, um die Adresse "
"zu bestätigen."

#: app.py:9519
msgid "Връзката за потвърждение е изтекла. Заявете нова от профила си."
msgstr ""
"Der Bestätigungslink ist abgelaufen. Fordern Sie einen neuen in Ihrem "
"Konto an."

#: app.py:9522 app.py:9528
msgid "Невалидна връзка за потвърждение."
msgstr "Ungültiger Bestätigungslink."

#: app.py:9533
msgid "Имейлът е потвърден успешно."
msgstr "E-Mail-Adresse erfolgreich bestätigt."

#: app.py:9548 app.py:9572 app.py:9640 app.py:9781
msgid "Грешна парола."
msgstr "Falsches Passwort."

#: app.py:9560
msgid "Този имейл вече се използва от друг акаунт."
msgstr "Diese E-Mail-Adresse wird bereits von einem anderen Konto verwendet."

#: app.py:9563
msgid "Имейлът е обновен. Изпратихме връзка за потвърждение на новия адрес."
msgstr ""
"E-Mail-Adresse aktualisiert. Wir haben einen Bestätigungslink an die neue"
" Adresse gesendet."

#: app.py:9585
msgid "Паролата е сменена успешно."
msgstr "Das Passwort wurde erfolgreich geändert."

#: app.py:9594
msgid "Имейлът вече е потвърден."
msgstr "Die E-Mail-Adresse ist bereits bestätigt."

#: app.py:9597
msgid "Нямате зададен имейл."
msgstr "Sie haben keine E-Mail-Adresse hinterlegt."

#: app.py:9600
msgid "Изпратихме нова връзка за потвърждение."
msgstr "Wir haben einen neuen Bestätigungslink gesendet."

#: app.py:9608
msgid "Двуфакторното удостоверяване вече е активирано."
msgstr "Die Zwei-Faktor-Authentifizierung ist bereits aktiviert."

#: app.py:9617
msgid "Невалиден код. Опитайте отново."
msgstr "Ungültiger Code. Bitte versuchen Sie es erneut."

#: app.py:9622
msgid "Двуфакторното удостоверяване е активирано."
msgstr "Die Zwei-Faktor-Authentifizierung wurde aktiviert."

#: app.py:9645
msgid "Двуфакторното удостоверяване е изключено."
msgstr "Die Zwei-Faktor-Authentifizierung wurde deaktiviert."

#: app.py:9784
msgid "Не можете да изтриете единствения администратор."
msgstr "Sie können den einzigen Administrator nicht löschen."

#: app.py:9790
#, python-format
msgid ""
"Профилът има свързани записи (%(what)s) и не може да бъде изтрит. "
"Свържете се с администратор."
msgstr ""
"Das Konto hat verknüpfte Datensätze (%(what)s) und kann nicht gelöscht "
"werden. Bitte wenden Sie sich an einen Administrator."

#: app.py:9808
msgid "Моля, изберете файл за качване."
msgstr "Bitte wählen Sie eine Datei zum Hochladen aus."

#: app.py:9812
msgid "Невалиден формат! Системата приема само .dxf файлове."
msgstr "Ungültiges Format. Das System akzeptiert nur .dxf-Dateien."

#: app.py:9833
#, python-format
msgid "Файлът \"%(filename)s\" беше качен и обработен успешно!"
msgstr "Die Datei \"%(filename)s\" wurde erfolgreich hochgeladen und verarbeitet."

#: app.py:9838
#, python-format
msgid "Критична грешка при обработка/запис: %(error)s"
msgstr "Kritischer Fehler bei Verarbeitung/Speicherung: %(error)s"

#: app.py:12689
msgid "Моля изберете файл."
msgstr "Bitte wählen Sie eine Datei aus."

#: app.py:12716
msgid "Файлът беше качен успешно."
msgstr "Die Datei wurde erfolgreich hochgeladen."

#: app.py:13493
msgid "Няма избран файл."
msgstr "Keine Datei ausgewählt."

#: app.py:13496
msgid "Приемат се само PDF файлове."
msgstr "Es werden nur PDF-Dateien akzeptiert."

#: app.py:13513
msgid "Моля въведете име на клиент."
msgstr "Bitte geben Sie einen Kundennamen ein."

#: app.py:13524 templates/order_create.html:786
msgid "Моля добавете поне един артикул към поръчката."
msgstr "Bitte fügen Sie der Bestellung mindestens einen Artikel hinzu."

#: app.py:13630
msgid "Невалидни артикули в поръчката."
msgstr "Ungültige Artikel in der Bestellung."

#: app.py:13641
#, python-format
msgid "Поръчка %(order_number)s беше успешно изпратена!"
msgstr "Bestellung %(order_number)s wurde erfolgreich übermittelt."

#: app.py:13649
#, python-format
msgid ""
"Внимание: поръчка %(order_number)s има недостатъчна наличност за: "
"%(missing_desc)s. Виж таблото \"Липсваща наличност\"."
msgstr ""
"Achtung: Bestellung %(order_number)s hat unzureichenden Bestand für: "
"%(missing_desc)s. Siehe das Dashboard \"Fehlender Bestand\"."

#: app.py:13776
msgid "Нямате достъп до тази поръчка."
msgstr "Sie haben keinen Zugriff auf diese Bestellung."

#: app.py:13780
msgid ""
"Поръчката вече е в процес на изработка (или вече е приключена/отменена) и"
" не може да бъде отменена."
msgstr ""
"Die Bestellung befindet sich bereits in Bearbeitung (oder ist bereits "
"abgeschlossen/storniert) und kann nicht storniert werden."

#: app.py:13787
#, python-format
msgid "Поръчка %(order_number)s беше отменена."
msgstr "Bestellung %(order_number)s wurde storniert."

#: app.py:16132
msgid "Моля въведете име на клиента."
msgstr "Bitte geben Sie den Namen des Kunden ein."

#: app.py:16170
msgid "Моля въведете име на куриера."
msgstr "Bitte geben Sie den Namen des Kurierdienstes ein."

#: app.py:24843
msgid "Страницата не е намерена"
msgstr "Seite nicht gefunden"

#: app.py:24844
msgid "Проверете адреса или се върнете към началото."
msgstr "Überprüfen Sie die Adresse oder kehren Sie zur Startseite zurück."

#: app.py:24849
msgid "Нямате достъп"
msgstr "Zugriff verweigert"

#: app.py:24850
msgid "Нямате права за тази страница."
msgstr "Sie haben keine Berechtigung für diese Seite."

#: app.py:24855
msgid "Твърде много опити"
msgstr "Zu viele Versuche"

#: app.py:24856
msgid "Изчакайте малко и опитайте отново."
msgstr "Bitte warten Sie einen Moment und versuchen Sie es erneut."

#: app.py:24861
msgid "Възникна грешка"
msgstr "Ein Fehler ist aufgetreten"

#: app.py:24862
msgid "Нещо се обърка от наша страна. Опитайте отново по-късно."
msgstr ""
"Auf unserer Seite ist etwas schiefgelaufen. Bitte versuchen Sie es später"
" erneut."

#: app.py:24869
msgid "Изтекла сесия на формата"
msgstr "Formularsitzung abgelaufen"

#: app.py:24870
msgid "Презаредете страницата и опитайте отново."
msgstr "Laden Sie die Seite neu und versuchen Sie es erneut."

