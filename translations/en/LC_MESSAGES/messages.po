msgid "Времето за въвеждане на кода изтече. Влезте отново."
msgstr "The time to enter the code has expired. Please sign in again."

#: app.py:9388
msgid "Невалиден код."
msgstr "Invalid code."

#: app.py:9414
msgid ""
"Ако имейлът съществува в системата, изпратихме връзка за възстановяване "
"на паролата."
msgstr "If that email exists in our system, we have sent a password reset link."

#: app.py:9427
msgid "Връзката за възстановяване е изтекла. Заявете нова."
msgstr "The reset link has expired. Please request a new one."

#: app.py:9430 app.py:9437
msgid "Невалидна връзка за възстановяване."
msgstr "Invalid reset link."

#: app.py:9445 app.py:9485 app.py:9577
msgid "Паролата трябва да бъде поне 8 символа."
msgstr "The password must be at least 8 characters."

#: app.py:9448 app.py:9580 templates/reset_password.html:42
msgid "Паролите не съвпадат."
msgstr "The passwords do not match."

#: app.py:9452
msgid "Паролата е сменена успешно. Влезте с новата парола."
msgstr "Password changed successfully. Please log in with your new password."

#: app.py:9465
msgid ""
"Сайтът е в момента на техническа поддръжка. Регистрацията на нови профили"
" е временно спряна."
msgstr ""
"The site is currently under maintenance. New account registration is "
"temporarily disabled."

#: app.py:9478 app.py:9552
msgid "Имейл е задължителен."
msgstr "Email is required."

#: app.py:9504
msgid "Това потребителско име или имейл вече съществува."
msgstr "This username or email already exists."

#: app.py:9508
msgid "Регистрацията е успешна! Проверете имейла си, за да потвърдите адреса."
msgstr "Registration successful. Check your email to confirm your address."

#: app.py:9519
msgid "Връзката за потвърждение е изтекла. Заявете нова от профила си."
msgstr "The confirmation link has expired. Request a new one from your account."

#: app.py:9522 app.py:9528
msgid "Невалидна връзка за потвърждение."
msgstr "Invalid confirmation link."

#: app.py:9533
msgid "Имейлът е потвърден успешно."
msgstr "Email confirmed successfully."

#: app.py:9548 app.py:9572 app.py:9640 app.py:9781
msgid "Грешна парола."
msgstr "Incorrect password."

#: app.py:9560
msgid "Този имейл вече се използва от друг акаунт."
msgstr "This email is already used by another account."

#: app.py:9563
msgid "Имейлът е обновен. Изпратихме връзка за потвърждение на новия адрес."
msgstr "Email updated. We sent a confirmation link to the new address."

#: app.py:9585
msgid "Паролата е сменена успешно."
msgstr "Password changed successfully."

#: app.py:9594
msgid "Имейлът вече е потвърден."
msgstr "The email is already confirmed."

#: app.py:9597
msgid "Нямате зададен имейл."
msgstr "You have not set an email."

#: app.py:9600
msgid "Изпратихме нова връзка за потвърждение."
msgstr "We sent a new confirmation link."

#: app.py:9608
msgid "Двуфакторното удостоверяване вече е активирано."
msgstr "Two-factor authentication is already enabled."

#: app.py:9617
msgid "Невалиден код. Опитайте отново."
msgstr "Invalid code. Please try again."

#: app.py:9622
msgid "Двуфакторното удостоверяване е активирано."
msgstr "Two-factor authentication has been enabled."

#: app.py:9645
msgid "Двуфакторното удостоверяване е изключено."
msgstr "Two-factor authentication has been disabled."

#: app.py:9784
msgid "Не можете да изтриете единствения администратор."
msgstr "You cannot delete the only administrator."

#: app.py:9790
#, python-format
msgid ""
"Профилът има свързани записи (%(what)s) и не може да бъде изтрит. "
"Свържете се с администратор."
msgstr ""
"The account has linked records (%(what)s) and cannot be deleted. Please "
"contact an administrator."

#: app.py:9808
msgid "Моля, изберете файл за качване."
msgstr "Please select a file to upload."

#: app.py:9812
msgid "Невалиден формат! Системата приема само .dxf файлове."
msgstr "Invalid format. The system only accepts .dxf files."

