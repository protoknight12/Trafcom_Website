#, python-format
msgid "Файлът \"%(filename)s\" беше качен и обработен успешно!"
msgstr "File \"%(filename)s\" was uploaded and processed successfully."

#: app.py:9838
#, python-format
msgid "Критична грешка при обработка/запис: %(error)s"
msgstr "Critical error during processing/saving: %(error)s"

