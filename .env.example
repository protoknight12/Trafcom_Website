SECRET_KEY=
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/cnc_calculator_db
FLASK_DEBUG=0

# Optional - powers the site chat widget (see api_chat() in app.py). Left
# unset, the widget still renders but shows a "temporarily unavailable"
# message instead of erroring the whole app.
ANTHROPIC_API_KEY=
# Only needed if your key is "identity-linked" (Console shows this at
# creation) - the API then rejects requests without a workspace id. Find it
# in the Console workspace's settings page URL (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=

# Optional - password-reset emails (send_email()). Left unset, mail is
# handed to localhost:25 with no auth (whatever local mail transport is on
# the server, e.g. a bare postfix install). Set these to switch to a real
# relay (Resend, Mailgun, etc.) instead - auth/TLS only turn on once
# SMTP_USER is set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional - encrypts RouterOS API credentials the LAN module (/admin/network)
# stores per device (NetworkDevice.api_username/api_password_encrypted), so a
# Mikrotik password never sits in the DB as plaintext. Left unset, the live
# DHCP-management actions (test connection, make a lease static) are disabled
# with a flash message - the rest of the module (inventory, map, audit) works
# fine either way. Generate one once and never change it without re-entering
# every stored credential (an old key can't decrypt what a new key encrypted):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETWORK_API_ENCRYPTION_KEY=

# LEGACY, one-time use only: Shelly energy meters are now managed from the
# /admin/power dashboard itself (add/remove/relink a machine there directly,
# no restart needed) - see docs/SHELLY_API.md's Configuration section. This
# variable is only read once, by seed_shelly_devices(), to migrate whatever
# is listed here into the DB the very first time the app starts after
# upgrading to that version. Leave it set for that first run if upgrading an
# existing install; a brand-new install can just add meters through the UI
# and leave this blank. Format if you do set it: "Име=host" pairs separated
# by commas; a bare host labels itself. Give each meter a DHCP reservation
# either way - a lease can move and meters are addressed by IP.
SHELLY_DEVICES=Главно табло=

# Optional, local development only: lets the Flask dev server relay go2rtc's camera video (production uses nginx /camstream/, see deploy/).
# CAMSTREAM_PROXY=1
# GO2RTC_URL=http://127.0.0.1:1984

# Optional - MQTT broker the Shelly devices publish to (start_mqtt_listener() in
# app.py). Left with MQTT_BROKER_HOST blank, the MQTT listener does not start.
# Keep MQTT_BROKER_PORT a number (1883 is the default): a blank value makes
# int() fail as soon as MQTT_BROKER_HOST is set.
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional - camera object-detection tuning (detection.py and the detection
# section of app.py). The values below are the built-in defaults. Do not leave
# them blank: a blank value stops the app from starting - delete the line instead.
# Seconds between two frames of one camera:
DETECT_INTERVAL=2
# Minimum detection confidence (0-1):
DETECT_MIN_SCORE=0.4
# Days of detection history kept before cleanup:
DETECT_KEEP_DAYS=30
# Frames bigger than this (source pixels) are also cut into tiles; 0 = off:
DETECT_TILE=960

# Optional - the site's public address, used to build the links in password-reset
# and email-verification mails. Unset, links are built from the incoming request's
# Host header (fine for local dev; on a public server set it).
PUBLIC_BASE_URL=

# Optional - set to 1 on a server reachable only over HTTPS, so the session cookie
# is never sent over plain HTTP. Leave blank for local development over http.
SESSION_COOKIE_SECURE=

# Optional - delete reading-log rows (Shelly/Solis/temperature/convector/heat pump) older than this many days,
# at most once a day, from the Shelly poller. Blank or 0 = keep everything (the default).
READINGS_KEEP_DAYS=
